APP_ENV=dev
WORK_DIR=workdir

MAILBOX_NAME=mailbox@example.com
MAILBOX_PASSWORD=replace-me

# Incoming tasks and outgoing Excel results. Both accounts share Beget servers.
INPUT_MAILBOX_NAME=planning@example.com
INPUT_MAILBOX_PASSWORD=replace-me

IMAP_SERVER=imap.beget.com
IMAP_PORT=993
IMAP_USE_SSL=true

SMTP_SERVER=smtp.beget.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false

# Корпоративный Outlook/Exchange-ящик, который отслеживает n8n.
INTERNAL_OUTLOOK_EMAIL=n8n-trigger@company.ru
# Leave empty if responses come from INTERNAL_OUTLOOK_EMAIL.
N8N_RESPONSE_SENDER=
MAIL_TIMEOUT_SECONDS=30
SEND_RESULTS_TO_REQUESTER=true
TRUSTED_REQUESTERS=requester@company.ru
INPUT_SUBJECT_PREFIX=[FORECAST_INPUT]
N8N_REQUEST_SUBJECT_PREFIX=[N8N_FORECAST_REQUEST]
N8N_RESPONSE_SUBJECT_PREFIX=[N8N_FORECAST_RESULT]
RESULT_MAILBOX=planning@example.com
POLL_INTERVAL_SECONDS=30
FORECAST_START_MONTH=
FORECAST_HORIZON_MONTHS=3
EXCEL_SHEET=
EXCEL_HEADER_ROW=1
