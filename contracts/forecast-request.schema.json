{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forecast-request.schema.json",
  "title": "Shipment forecast request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "created_at", "reply_to", "directions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "reply_to": { "type": "string", "format": "email" },
    "directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction_id", "shipping_point", "delivery_region", "attributes"],
        "properties": {
          "direction_id": { "type": "string", "minLength": 1 },
          "shipping_point": { "type": "string", "minLength": 1 },
          "delivery_region": { "type": "string", "minLength": 1 },
          "attributes": { "type": "object" }
        }
      }
    }
  }
}

